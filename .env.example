# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.
# Real environment variables override anything set here.
#
#   cp .env.example .env
#   uv run platform-api

# --- Sending invite emails (SMTP) -------------------------------------------
# REQUIRED. The API refuses to start unless all five of SMTP_HOST, SMTP_PORT,
# SMTP_USER, SMTP_PASSWORD and SMTP_FROM are set — every invite, address
# confirmation and password reset goes out this way, and a server that cannot
# send them accepts invites it then silently never delivers. SMTP_FROM must be
# changed from the no-reply@assessment.local placeholder: that domain has no MX,
# so mail sent from it bounces at the receiver.
#
# Offline local dev only: ALLOW_UNCONFIGURED_EMAIL=true boots anyway and logs the
# link instead of sending it (add LOG_PII=true to log it verbatim). Never set it
# in a deployment — it turns undeliverable mail back into silence.
# ALLOW_UNCONFIGURED_EMAIL=true
#
# Gmail: enable 2-Step Verification on the account, then create an App Password
# (Google Account -> Security -> App passwords) and paste the 16 characters
# below WITHOUT spaces. Your normal account password will not work.
# SMTP_FROM must be the same address as SMTP_USER — Gmail rewrites From to the
# authenticated user anyway.
#
# Gmail is fine for testing but rate-limits and often lands in spam. For real
# candidates use a transactional provider (SES / Postmark / Resend) with a
# verified sending domain.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=you@gmail.com
SMTP_USE_TLS=true
# Per socket operation; SMTP_DEADLINE_S bounds one whole multi-recipient send, so
# a slow mail server cannot hold an HTTP request open in proportion to the
# recipient count.
# SMTP_TIMEOUT_S=10
# SMTP_DEADLINE_S=30

# --- Results webhook (X06) ---------------------------------------------------
# When a sitting finishes, the interviewer is emailed and — if the organisation
# has set one on PATCH /orgs/current — a signed "results.ready" event is POSTed
# to its webhook URL. Nothing here is required; both settings are guardrails.
#
# How long one webhook POST may take before it is abandoned. Short on purpose:
# the send runs in a background task off the agent's grading callback.
# RESULTS_WEBHOOK_TIMEOUT_S=5
#
# The webhook URL is customer-supplied and fetched by THIS server, which is the
# textbook SSRF shape — so https and publicly-routable addresses only, checked
# both when the URL is saved and again when it is used. Setting this to true
# lifts both checks and is for local development against a localhost endpoint;
# never set it in a deployment, where it would let one tenant aim the POST at
# the cloud metadata service or another tenant's internal address.
# ALLOW_PRIVATE_WEBHOOKS=true

# --- Interviewer auth --------------------------------------------------------
# REQUIRED in production. If unset, an ephemeral per-process secret is generated
# and every token dies on restart.
# JWT_SECRET=generate-a-long-random-string
# Access tokens are short-lived (memory-only in the SPA); the refresh cookie is
# what keeps a browser signed in. Secure defaults on when PLATFORM_BASE_URL is
# https; SameSite lax suits one site (same host / subdomains), none otherwise.
# JWT_EXPIRE_MIN=15
# REFRESH_EXPIRE_DAYS=30
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax
# New passwords are checked against Have I Been Pwned (hash prefix only).
# PASSWORD_BREACH_CHECK=true

# --- Agent <-> platform shared secrets ---------------------------------------
# Set BOTH in production, matching the agent's values. Unset = auth disabled.
# ASSESS_API_TOKEN=shared-secret-we-send-to-the-agent
# CALLBACK_TOKEN=shared-secret-the-agent-sends-back
# HMAC body-signing (defense in depth; never transmitted). Match the agent's
# ASSESS_SIGNING_SECRET / CALLBACK_SIGNING_SECRET. Enforced only when set.
# ASSESS_SIGNING_SECRET=long-random-secret-shared-with-the-agent
# CALLBACK_SIGNING_SECRET=long-random-secret-shared-with-the-agent

# --- Behind a reverse proxy / load balancer ----------------------------------
# REQUIRED once the API is not exposed directly. Without it every request appears
# to come from the proxy's IP, so all callers share ONE rate-limit bucket and the
# first few exhaust it for everybody. Only turn it on when a proxy you control
# rewrites X-Forwarded-For — it is a client-supplied header otherwise.
# TRUST_PROXY_HEADERS=true

# --- Fresh local database ----------------------------------------------------
# Tables are created on startup ONLY when this is true. It defaults OFF so
# production (which runs `alembic upgrade head`) can't silently paper over a
# missing migration. On a fresh clone, either set this or run Alembic once:
#   uv run alembic upgrade head
# AUTO_CREATE_TABLES=true

# --- Optional ----------------------------------------------------------------
# Rate limits: requests per RATE_LIMIT_WINDOW_S per client. 0 disables a bucket.
# DRAFT_RATE_LIMIT_MAX guards the only endpoint that spends LLM money.
# RATE_LIMIT_WINDOW_S=60
# LOGIN_RATE_LIMIT_MAX=10
# REGISTER_RATE_LIMIT_MAX=5
# DRAFT_RATE_LIMIT_MAX=10
# SUBMIT_RATE_LIMIT_MAX=20
# RUN_RATE_LIMIT_MAX=60
# DATABASE_URL=sqlite:///./platform.db
# These three must all use the SAME host spelling, and it must be 127.0.0.1.
# `localhost` and `127.0.0.1` are different sites to a browser: mixing them mints
# dead invite links AND silently voids the SameSite=lax refresh cookie, so
# sign-in stops surviving a reload while still looking like it worked. The agent
# also rejects a callback_url host of exactly "localhost", so the IP literal is
# the only spelling that works end to end. web/vite.config.ts pins the dev server
# to match.
# AGENT_BASE_URL=http://127.0.0.1:8000
# PLATFORM_BASE_URL=http://127.0.0.1:9000
# FRONTEND_BASE_URL=http://127.0.0.1:5173
# Browser origins allowed to call the API. Defaults to FRONTEND_BASE_URL alone —
# keep it to ONE origin. Listing both spellings makes a wrong-host browse look
# like it works, right up until the session dies.
# CORS_ORIGINS=http://127.0.0.1:5173
# Gates FOUNDING a new organisation. Adding someone to an organisation that
# already exists goes through an org invite instead (POST /orgs/current/invites),
# which is addressed to one address, expires, and records who sent it.
# REGISTRATION_CODE=invite-only-signup-code
# Log recipient emails + invite links verbatim. OFF by default so prod log
# aggregation never ingests candidate PII; turn ON locally to copy the invite
# link from the logs when SMTP is unset.
# LOG_PII=true

# --- Billing (X02) ----------------------------------------------------------
# Whether plan limits actually refuse work. ON by default. Turn it OFF to meter a
# deployment for a month before charging: usage and per-tenant LLM cost are
# recorded either way, nothing is refused.
# BILLING_ENFORCED=false
# Stripe. Unset (the default) leaves every organisation on the free plan with
# limits still enforced, and makes the checkout/portal routes answer 503 rather
# than half-work. The webhook secret is the ONLY authentication that endpoint
# has — it is public — so without it the webhook refuses to process anything.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# The Stripe Price id behind each paid plan in billing.PLANS. Prices live in
# Stripe (that is where they are versioned and where the currency lives); these
# only map our plan names onto theirs.
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_GROWTH=price_...
# Charge VAT / sales tax via Stripe Tax (X17). ON by default: selling into the
# EU/UK without charging and remitting it is a liability that grows silently
# with revenue. Requires Stripe Tax to be ACTIVATED on the Stripe account and a
# registration wherever a threshold is crossed — without that, checkout fails
# loudly at session creation rather than quietly selling untaxed.
# STRIPE_AUTOMATIC_TAX=false
